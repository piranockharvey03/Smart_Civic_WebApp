# Copy this file to .env and fill values
APP_NAME="Smart Civic App"
APP_ENV=local
APP_DEBUG=true
BASE_URL=http://localhost/app

# App key (generate a random string for session/encryption if needed)
APP_KEY=

# Database
DB_HOST=127.0.0.1
DB_NAME=smart_civic_app
DB_USER=root
DB_PASS=
